#!/usr/bin/env bash

# Wrapper around the GitHub Copilot CLI that points it at supported OpenAI
# models using the CLI's BYOK support. Run `copilot help providers` for the full
# list of provider environment variables.

set -euo pipefail

resolve_script_dir() {
  local source="${BASH_SOURCE[0]}"
  local directory
  local target

  while [ -L "$source" ]; do
    directory=$(cd -P -- "$(dirname -- "$source")" && pwd)
    target=$(readlink -- "$source")
    if [[ "$target" == /* ]]; then
      source="$target"
    else
      source="$directory/$target"
    fi
  done

  cd -P -- "$(dirname -- "$source")" && pwd
}

SCRIPT_DIR=$(resolve_script_dir)
# shellcheck source=scripts/lib/terminal-style.sh
source "$SCRIPT_DIR/lib/terminal-style.sh"

SUPPORTED_MODELS=(gpt-5.6-sol gpt-5.6-terra gpt-5.6-luna gpt-6-astra gpt-6-luna gpt-6-sol gpt-6.1-sol gpt-6.1-terra gpt-6.2-sol gpt-6.2-astra)

usage() {
  local fd="${1:-1}"
  # Lay out supported models as a table: rows are versions ("X.Y" in
  # "gpt-X.Y-name"), columns are model families ("name"), so the full set
  # stays easy to scan as more models are added.
  local -A cell_id=()
  local -A family_seen=()
  local -A version_seen=()
  local -A col_width=()
  local family_order=()
  local version_order=()
  local model version name family row_header="version" row_label_width cell

  for model in "${SUPPORTED_MODELS[@]}"; do
    name="${model##*-}"
    version="${model%-"$name"}"
    version="${version#gpt-}"
    cell_id["$version|$name"]="$model"
    if [ -z "${family_seen[$name]:-}" ]; then
      family_seen[$name]=1
      family_order+=("$name")
    fi
    if [ -z "${version_seen[$version]:-}" ]; then
      version_seen[$version]=1
      version_order+=("$version")
    fi
  done

  mapfile -t family_order < <(printf '%s\n' "${family_order[@]}" | sort)

  row_label_width="${#row_header}"
  for version in "${version_order[@]}"; do
    if [ "${#version}" -gt "$row_label_width" ]; then
      row_label_width="${#version}"
    fi
  done

  for family in "${family_order[@]}"; do
    col_width["$family"]="${#family}"
    for version in "${version_order[@]}"; do
      cell="${cell_id[$version|$family]:--}"
      if [ "${#cell}" -gt "${col_width[$family]}" ]; then
        col_width["$family"]="${#cell}"
      fi
    done
  done

  {
    terminal_style_heading "Usage:"
    printf '\n  '
    terminal_style_command "$0"
    printf ' '
    terminal_style_option "<model_id>"
    printf ' '
    terminal_style_option "[copilot_args...]"
    printf '\n\nRequires '
    terminal_style_option "OPENAI_API_KEY"
    printf ' to be set in the environment.\n\n'
    terminal_style_heading "Supported models:"
    printf '\n  '
    terminal_style_heading "$(printf '%-*s' "$row_label_width" "$row_header")"
    for family in "${family_order[@]}"; do
      printf '  '
      terminal_style_heading "$(printf '%-*s' "${col_width[$family]}" "$family")"
    done
    printf '\n'
    for version in "${version_order[@]}"; do
      printf '  '
      terminal_style_option "$(printf '%-*s' "$row_label_width" "$version")"
      for family in "${family_order[@]}"; do
        cell="${cell_id[$version|$family]:-}"
        printf '  '
        if [ -n "$cell" ]; then
          terminal_style_code "$(printf '%-*s' "${col_width[$family]}" "$cell")"
        else
          terminal_style_detail "$(printf '%-*s' "${col_width[$family]}" "-")"
        fi
      done
      printf '\n'
    done
  } >&"$fd"
}

error() {
  {
    terminal_style_status_title error "Error:"
    printf ' '
    terminal_style_status_message "$1"
    printf '\n'
  } >&2
}

if [ $# -lt 1 ]; then
  error "Missing <model_id> argument"
  printf '\n' >&2
  usage 2
  exit 1
fi

MODEL_ID="$1"
shift

case "$MODEL_ID" in
  gpt-5.6-sol | gpt-5.6-terra | gpt-5.6-luna | gpt-6-astra | gpt-6-luna | gpt-6-sol | gpt-6.1-sol | gpt-6.1-terra | gpt-6.2-sol | gpt-6.2-astra)
    AGENT_CONFIG_MODEL="$MODEL_ID"
    WIRE_MODEL="$MODEL_ID"
    ;;
  *)
    error "Unknown model '$MODEL_ID'"
    printf '\n' >&2
    usage 2
    exit 1
    ;;
esac

if [ -z "${OPENAI_API_KEY:-}" ]; then
  error "OPENAI_API_KEY is not set"
  exit 1
fi

if ! command -v copilot >/dev/null 2>&1; then
  error "Could not find the 'copilot' command on PATH"
  exit 1
fi

export COPILOT_PROVIDER_TYPE="openai"
export COPILOT_PROVIDER_BASE_URL="https://api.openai.com/v1"
export COPILOT_PROVIDER_API_KEY="$OPENAI_API_KEY"

# OpenAI rejects function tools on /v1/chat/completions for GPT-5/6 models, so the
# CLI has to talk to /v1/responses instead.
export COPILOT_PROVIDER_WIRE_API="responses"

# Copilot's model catalogue and the provider's wire model can diverge. Keep a
# catalogue-backed model ID for agent configuration while sending the provider's
# expected model name on the wire.
export COPILOT_PROVIDER_MODEL_ID="$AGENT_CONFIG_MODEL"
export COPILOT_PROVIDER_WIRE_MODEL="$WIRE_MODEL"

terminal_style_status_title progress "Starting:"
printf ' '
terminal_style_status_message "Copilot CLI with "
terminal_style_code "$WIRE_MODEL"
printf '\n'
exec copilot "$@"
